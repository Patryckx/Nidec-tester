                   <string notr="true">QPushButton {
	
	color: rgb(255, 255, 255);
	background-color: rgb(11, 186, 78);
     border: 4px solid rgb(11, 186, 78); /* Borde para el QStackedWidget */
    border-radius: 25px; /* Bordes redondeados solo para el QStackedWidget */
    padding: 5px; /* Opcional: agrega espacio interno */
}

QPushButton &gt; * {
    border: none; /* Asegura que los elementos dentro del QStackedWidget no hereden el borde */
    border-radius: 0px; /* Restablece el border-radius para los elementos internos */
    background-color: transparent; /* Opción para mantener el fondo de los elementos internos */
}</string>
